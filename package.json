{
  "name": "api-engine",
  "version": "0.0.801",
  "description": "API engine for async fetching",
  "main": "./index.js",
  "types": "./index.d.ts",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "rimraf dist",
    "clean_win": "rmdir /s /q dist",
    "build": "npm run clean && tsc && shx cp package.json dist && shx cp README.md dist",
    "publish": "npm publish dist --registry http://151.248.114.248:5000/",
    "dev": "vite"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Skobeltsyn/api-engine.git"
  },
  "keywords": [
    "remote",
    "fetch"
  ],
  "author": "K.Skobeltsyn",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Skobeltsyn/api-engine/issues"
  },
  "homepage": "https://github.com/Skobeltsyn/api-engine#readme",
  "dependencies": {
    "typescript": "^5.8.2"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.5",
    "jsdom": "^25.0.0",
    "rimraf": "^5.0.5",
    "shx": "^0.3.4",
    "vitest": "^4.1.5"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./index.js",
      "types": "./index.d.ts"
    }
  }
